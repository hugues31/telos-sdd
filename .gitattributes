# The `.tel` canonical form is byte-exact: LF endings, exactly one trailing
# newline, no trailing spaces. Never let a checkout rewrite them -- the
# round-trip tests compare bytes, on Windows CI too.
*.tel text eol=lf
crates/telos-core/tests/corpus/** text eol=lf
# The rebuild demo is executable documentation: its tests match exact
# LF-delimited markers in the README and compare demo bytes.
demo/** text eol=lf
# The installers are fetched raw from GitHub and piped straight into
# sh/PowerShell: keep the committed bytes LF on every checkout.
install.sh text eol=lf
install.ps1 text eol=lf
