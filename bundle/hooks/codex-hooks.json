{
  "description": "Require every Telos repository mutation to pass through the CLI broker.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "telos guard",
            "commandWindows": "telos.exe guard",
            "timeout": 5,
            "statusMessage": "Checking Telos strict mutation policy"
          }
        ]
      }
    ]
  }
}
