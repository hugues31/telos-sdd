# Telos RTK native prompts: keep this block intact for guard verification.

prefix_rule(
    pattern = ["rtk", "telos", "plan", "approve"],
    decision = "prompt",
    justification = "Approve the exact Telos plan revision digest and scope",
)

prefix_rule(
    pattern = ["rtk", "proxy", "telos", "plan", "approve"],
    decision = "prompt",
    justification = "Approve the exact Telos plan revision digest and scope",
)
